! ===========================================================
! Electric Vehicle Chargers
! ===========================================================

! 电动汽车充电桩（可控负荷）
! 电压分支(不走L2_2_3): EV_Bus19(bus19,400kW) — EV_Bus20 已合并至 bus19
! 热极限分支(走L2_2_3): EV_Bus7(bus7,600kW) — bus7经L6_6_7(360A), 受L2_2_3瓶颈约束
!
! 官方语义: Load 实际功率 = kw × LoadShape.mult
! kw 为满载容量; 绑定的 LoadShape.mult 为当前实际挂载比例
! EV_Bus19 满载400kW, 当前实际挂载 200kW (原80+120) → mult=(0.5)
! (Load 未绑定 shape 时当前挂载 = 满载, mult 视为 1.0)

! 当前挂载比例 (npts=1 静态断面, 单断面只取 mult[0])
New LoadShape.EV_Bus19_cur npts=1 interval=1 mult=(0.5)
New LoadShape.EV_Bus7_cur npts=1 interval=1 mult=(0.25)

New Load.EV_Bus19 phases=3 bus1=bus19.1.2.3 conn=wye kv=12.66 kw=400 kvar=100 model=1 status=variable
~ daily=EV_Bus19_cur
New Load.EV_Bus7 phases=3 bus1=bus7.1.2.3 conn=wye kv=12.66 kw=600 kvar=150 model=1 status=variable
~ daily=EV_Bus7_cur
