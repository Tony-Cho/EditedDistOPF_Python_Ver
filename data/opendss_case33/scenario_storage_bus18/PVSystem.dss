! ===========================================================
! 分布式光伏系统 - 使用 PVSystem 元件
! ===========================================================

! PVSystem 参数说明:
! - Pmpp: 最大功率点功率 (kW, 满辐照额定容量)
! - kW: 当前输出功率 (kW)
! - PF: 功率因数
! - eff: 效率
! - temperaturecoeff: 温度系数
! - irradiance: 当前辐照度兜底值 (0-1, 1.0=满辐照), 仅未绑定 LoadShape 时生效
!   本文件已显式写入 irradiance=1.0 (作为兜底定义, 方便后续工作); 绑定了
!   LoadShape 时由 mult 替代 (当前 mult=(0.65) → 实际辐照度 0.65)
!   可用出力上限 P_avail = Pmpp × 辐照度 (MPPT 决定上限, 优化器在 0~P_avail 连续调节)
!
! 辐照度曲线 (绑定 LoadShape, 约定: mult 本身即辐照度, 替代 irradiance 字段):
!   时间尺度选项 (PVSystem 支持三种 LoadShape 绑定, 均为可选):
!     daily  : 日曲线 (粒度自由, 如 96 点 × 15min 或 24 点 × 1h) — 当前场景使用
!     duty   : 短周期曲线 (秒/分钟级, 云层快速遮挡等)
!     yearly : 年曲线 (365 点, 季节变化)
!   配套可选字段:
!     Temperature / TShape : 温度曲线 (TempShape 对象), 温度修正 Pmpp
!     %Cutin / %Cutout    : 切入/切出辐照度阈值 (逆变器启停)
!   当前断面: 单断面 npts=1, mult[0]=0.65 → 当前辐照度 0.65
!   (0.65 对应一天中辐照度为 0.65 的时刻, 如晴天上午/下午某时)
!   扩展为全天曲线时改为 npts=96 interval=0.25 mult=(全天 96 点, 15min 粒度), 多时段按时段取点

! 光伏分布: 主干 bus6(300kW), bus14(400kW); 支路 bus19(300kW), bus25(300kW), bus31(400kW); 合计 1700 kW

! 当前断面辐照度曲线 (npts=1 静态断面, 单断面取 mult[0])
New LoadShape.PV_Bus6_irr npts=1 interval=1 mult=(0.65)
New LoadShape.PV_Bus14_irr npts=1 interval=1 mult=(0.65)
New LoadShape.PV_Bus19_irr npts=1 interval=1 mult=(0.65)
New LoadShape.PV_Bus25_irr npts=1 interval=1 mult=(0.65)
New LoadShape.PV_Bus31_irr npts=1 interval=1 mult=(0.65)

New PVSystem.PV_Bus6 phases=3 bus1=bus6.1.2.3 conn=wye kV=12.66 
~ Pmpp=300 kW=300 PF=1.0 eff=0.95 temperaturecoeff=-0.004 
~ irradiance=1.0 status=variable
~ daily=PV_Bus6_irr

New PVSystem.PV_Bus14 phases=3 bus1=bus14.1.2.3 conn=wye kV=12.66 
~ Pmpp=400 kW=400 PF=1.0 eff=0.95 temperaturecoeff=-0.004 
~ irradiance=1.0 status=variable
~ daily=PV_Bus14_irr

New PVSystem.PV_Bus19 phases=3 bus1=bus19.1.2.3 conn=wye kV=12.66 
~ Pmpp=300 kW=300 PF=1.0 eff=0.95 temperaturecoeff=-0.004 
~ irradiance=1.0 status=variable
~ daily=PV_Bus19_irr

New PVSystem.PV_Bus25 phases=3 bus1=bus25.1.2.3 conn=wye kV=12.66 
~ Pmpp=300 kW=300 PF=1.0 eff=0.95 temperaturecoeff=-0.004 
~ irradiance=1.0 status=variable
~ daily=PV_Bus25_irr

New PVSystem.PV_Bus31 phases=3 bus1=bus31.1.2.3 conn=wye kV=12.66 
~ Pmpp=400 kW=400 PF=1.0 eff=0.95 temperaturecoeff=-0.004 
~ irradiance=1.0 status=variable
~ daily=PV_Bus31_irr
