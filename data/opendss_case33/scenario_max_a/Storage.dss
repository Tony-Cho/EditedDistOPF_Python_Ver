! ===========================================================
! Energy Storage Systems (BESS)
! ===========================================================

! 分布式储能设备 - 使用 OpenDSS Storage 元件
! 储能充电: P>0 (吸收功率), 放电: P<0 (注入功率)

! BESS_Bus2: 瓶颈前, 100kW/200kWh (2h)
New Storage.BESS_Bus2 phases=3 bus1=bus2.1.2.3 conn=wye kV=12.66 kW=100 kWh=200 %Charge=100 %Discharge=100 
~ chargeEff=0.95 dischargeEff=0.95
~ stateOfCharge=0.5 status=variable

! BESS_Bus6: 主干中段, 75kW/150kWh (2h)
New Storage.BESS_Bus6 phases=3 bus1=bus6.1.2.3 conn=wye kV=12.66 kW=75 kWh=150 %Charge=100 %Discharge=100 
~ chargeEff=0.95 dischargeEff=0.95
~ stateOfCharge=0.6 status=variable

! BESS_Bus14: 主干中后段, 100kW/200kWh (2h)
New Storage.BESS_Bus14 phases=3 bus1=bus14.1.2.3 conn=wye kV=12.66 kW=100 kWh=200 %Charge=100 %Discharge=100 
~ chargeEff=0.95 dischargeEff=0.95
~ stateOfCharge=0.5 status=variable

! BESS_Bus25: 支路2末端, 75kW/150kWh (2h)
New Storage.BESS_Bus25 phases=3 bus1=bus25.1.2.3 conn=wye kV=12.66 kW=75 kWh=150 %Charge=100 %Discharge=100 
~ chargeEff=0.95 dischargeEff=0.95
~ stateOfCharge=0.5 status=variable